# ──────────────────────────────────────────────────────────────
#  FRONTEND environment variables  (frontend/.env.example)
#
#  1. Copy this file to a new file named  .env  in the SAME folder
#     as package.json  (frontend/.env).
#  2. Restart `npm run dev` after every change (Vite reads .env at startup).
#
#  ⚠ Everything starting with VITE_ is bundled into the browser code and
#    can be read by ANYONE who opens your website. Only put PUBLIC values
#    here. NEVER put AI keys (Gemini), database passwords, JWT secrets, or
#    storage secrets in this file. Those belong in backend/.env only.
# ──────────────────────────────────────────────────────────────

# Public URL of your Spring Boot backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8080

# Prefix shared by all backend routes. Change it if your backend uses another one.
VITE_API_PREFIX=/api

# true  = use fake data from src/mocks (no backend needed)
# false = call the real Spring Boot backend
VITE_USE_MOCK=true
