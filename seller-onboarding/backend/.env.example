# ──────────────────────────────────────────────────────────────
#  BACKEND environment variables  (backend/.env.example)
#
#  1. Copy this file to  backend/.env  (same folder as pom.xml).
#  2. Fill in real values. NEVER commit .env to Git.
#  3. Run the app from the backend/ folder:  mvn spring-boot:run
#     (application.properties loads .env automatically.)
#
#  This is where ALL private values live: JWT secret, database
#  password, Gemini API key, storage settings.
# ──────────────────────────────────────────────────────────────

# ---- Authentication ----
# REQUIRED. At least 32 random characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MINUTES=120

# ---- Database ----
# Quick start (default if you leave these out): H2 file database in ./data
# PostgreSQL example:
# DB_URL=jdbc:postgresql://localhost:5432/selleronboarding
# DB_USERNAME=postgres
# DB_PASSWORD=your-database-password
# DDL_AUTO=update

# ---- Frontend origins allowed to call this API (CORS), comma-separated ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Gemini (AI assistant) ----
# Get a key from Google AI Studio. Leave empty to disable the assistant (chat returns a friendly error).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Document storage ----
# Local folder for uploaded files (fine for development).
UPLOAD_DIR=./uploads
